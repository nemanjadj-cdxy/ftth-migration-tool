  },
  "TmfApi": {
    "ServiceInventoryManagementV4BaseUrl": "<SERVICE_INVENTORY_MANAGEMENT_V4_BASE_URL>",
    "ResourceInventoryManagementV4BaseUrl": "<RESOURCE_INVENTORY_MANAGEMENT_V4_BASE_URL>",
    "ServiceCatalogManagementV4BaseUrl": "<SERVICE_CATALOG_MANAGEMENT_V4_BASE_URL>",
    "ResourceCatalogManagementV4BaseUrl": "<RESOURCE_CATALOG_MANAGEMENT_V4_BASE_URL>"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
